desc:CG Resonator - tuned feedback-comb bank excited by the live guitar
tags:musique-concrete resonator comb live
slider1:110<30,1000,0.01:log>Root (Hz)
slider2:0<0,1,1{Fixed,Track pitch (bus)}>Root Source
slider3:0<0,7,1{Harmonic,Odd,Fifths + Octaves,Minor Pentatonic,Whole-tone,Bell (inharmonic),Quarter-tone Cluster,Octave Stack}>Ratio Set
slider4:6<1,8,1>Combs
slider5:8<0,60,0.1>Detune Spread (cents)
slider6:1.5<0.05,10,0.01:log>Decay RT60 (s)
slider7:6000<500,16000,1:log>Damping (Hz)
slider8:1<0,2,0.01>Excitation
slider9:0.7<0,1,0.01>Stereo Width
slider10:80<5,1000,1:log>Retune Glide (ms)
slider11:-3<-60,6,0.1>Wet (dB)
slider12:0<-60,6,0.1>Dry (dB)
slider13:0<0,3,1{Auto,L,R,L+R}>Input
slider14:1<1,4,1>Analysis Bus (1-4)
slider15:0<0,6,1{None,Level,Onset,Brightness,Noisiness,Flux,Pitch}>Mod Source
slider16:0<-2,2,0.01>Mod -> Root (octaves)
slider17:0<-1,1,0.01>Mod -> Decay (+-3 octaves of time)
slider18:0<0,1,1{-,PANIC}>Panic / Clear

in_pin:Input L
in_pin:Input R
out_pin:Output L
out_pin:Output R
options:gmem=CGbus no_meter

@init

ext_noinit=1;
PI=3.141592653589793; TWOPI=6.283185307179586; CEIL=2;

// ---- NaN-safe primitives. Comparisons with NaN are false, so every function below maps NaN/inf to a finite value ----
function lim(x,lo,hi) ( x>=lo ? (x<=hi ? x : hi) : lo );
function fin(x) ( abs(x)<100000 ? x : 0 );
function db2lin(d) ( exp(lim(d,-120,60)*0.11512925464970229) );
function dbgain(d) ( d<=-59.9 ? 0 : db2lin(d) );
function lin2db(x) ( 8.685889638065035*log(abs(x)+0.000000001) );
function sat(x) ( abs(x)<3 ? x*(27+x*x)/(27+9*x*x) : (x>0 ? 1 : -1) );
function sclip(x,c) local(ax,k,y) ( ax=abs(x); k=c*0.7; y=ax<k ? ax : k+(c-k)*sat((ax-k)/(c-k)); x<0 ? -y : y );
function mixf(a,b,t) ( a+(b-a)*t );
function lpc(fc) ( 1-exp(-TWOPI*lim(fc,1,srate*0.45)/srate) );
function smooth01(t) ( t<=0 ? 0 : (t>=1 ? 1 : t*t*(3-2*t)) );
function rnd() ( rng=rng*1664525+1013904223; rng-=floor(rng/4294967296)*4294967296; rng/4294967296 );
function rnds() ( rnd()*2-1 );
function alloc(n) local(p) ( p=mp; mp+=n; memset(p,0,n); p );

// ---- mono input pick (guitar usually lives on one channel) + DC block ----
function pick_in() local(yy) (
  eL+=(inL*inL-eL)*0.0005; eR+=(inR*inR-eR)*0.0005;
  imode<0.5 ? ( xm = eR<0.0005*eL ? inL : (eL<0.0005*eR ? inR : (inL+inR)*0.5) )
  : ( imode<1.5 ? ( xm=inL ) : ( imode<2.5 ? ( xm=inR ) : ( xm=(inL+inR)*0.5 ) ) );
  yy=xm-dcx+dcr*dcy; dcx=xm; dcy=yy; xm=fin(yy);
);

// ---- onset detector (fast/slow envelope ratio with refractory time) ----
function ons_proc(x) local(a) (
  a=abs(x);
  ons_f+=(a-ons_f)*(a>ons_f ? ons_kfa : ons_kfr);
  ons_s+=(a-ons_s)*(a>ons_s ? ons_ksa : ons_ksr);
  ons_ev=0;
  ons_cool>0 ? ons_cool-=1;
  (ons_cool<=0 && ons_f>ons_thr && ons_f>ons_s*ons_ratio) ? ( ons_ev=1; ons_cool=ons_refr; ons_cnt+=1; );
);

// ---- analysis bus (written by CG_Analyzer, optional for every other module) ----
function bus_update() (
  bus_b=(lim(floor(bus_sel+0.5),1,4)-1)*16;
  hb=gmem[bus_b];
  abs(hb-hb_last)>0.5 ? ( hb_last=hb; bus_stale=0; ) : ( bus_stale+=samplesblock; );
  bus_alive=bus_stale<srate*0.4;
);
function bus_get(sel) ( (sel>0.5 && bus_alive) ? lim(gmem[bus_b+floor(sel+0.5)],0,1) : 0 );
function bus_onset() local(c,r) ( r=0; bus_alive ? ( c=gmem[bus_b+10]; abs(c-bus_cnt_last)>0.5 ? ( r=1; bus_cnt_last=c; ); ); r );
mp=0;

NC=8;
DLM=floor(srate/30)+16;
cbuf=alloc(NC*DLM);
clp=alloc(NC); dsm=alloc(NC); cen=alloc(NC); lrt=alloc(NC); pl_=alloc(NC); pr_=alloc(NC); dtab=alloc(NC); rat=alloc(64);
rng=987654321;
i=0; while(i<NC) ( dtab[i]=rnds(); i+=1; );
function setr(s,a,b,c,d,e,f,g,h) local(o) ( o=s*8; rat[o]=a;rat[o+1]=b;rat[o+2]=c;rat[o+3]=d;rat[o+4]=e;rat[o+5]=f;rat[o+6]=g;rat[o+7]=h; );
setr(0,1,2,3,4,5,6,7,8);
setr(1,1,3,5,7,9,11,13,15);
setr(2,1,1.5,2,3,4,6,8,12);
setr(3,1,1.2,1.3333,1.5,1.8,2,2.4,3);
setr(4,1,1.1225,1.2599,1.4142,1.5874,1.7818,2,2.2449);
setr(5,1,2.76,5.4,8.93,13.34,18.64,24.82,31.9);
setr(6,1,1.0293,1.0595,1.0905,1.1225,1.1553,1.1892,1.2240);
setr(7,1,2,4,8,1.5,3,6,12);
wp=0; lr=log(110); k_g=0.001; k_d=1-exp(-1/(0.08*srate)); root_t=110; trk_hz=110; trk_on=0; nact=6;
md_root=0; md_dec=0; width=0.7; rlv=0; k_rl=1-exp(-1/(0.15*srate)); dn=0.000000000000001; LSR=log(srate);
FMAX=min(srate*0.2,9000);

function do_clear() ( memset(cbuf,0,NC*DLM); memset(clp,0,NC); memset(cen,0,NC); rlv=0; );

function read_params() (

bus_sel=slider14; imode=slider13; msel=slider15;
T_wet=dbgain(slider11); T_dry=dbgain(slider12);
T_exc=lim(slider8,0,2); T_decay=lim(slider6,0.05,10); T_damp=lpc(lim(slider7,500,16000));
md_root=lim(slider16,-2,2); md_dec=lim(slider17,-1,1); mod_t=bus_get(msel);
trk_on=slider2>0.5;
(trk_on && bus_alive && gmem[bus_b+7]>0.45 && gmem[bus_b+9]>40 && gmem[bus_b+9]<1000) ? ( trk_hz=gmem[bus_b+9]; );
root_t=lim((trk_on ? trk_hz : slider1)*exp(md_root*mod_s*0.6931471805599453),20,2000);
nact=lim(floor(slider4+0.5),1,8);
k_g=1-exp(-1/(lim(slider10,5,1000)*0.001*srate));
k_d=k_g;
width=lim(slider9,0,1);
set=lim(floor(slider3+0.5),0,7);
i=0; while(i<8) (
  lrt[i]=log(max(rat[set*8+i],0.25))+lim(slider5,0,60)*dtab[i]*0.000577622650466621;
  ang=((i/7)*2-1)*width; ang=(ang*0.5+0.5)*1.5707963267948966; pl_[i]=cos(ang); pr_[i]=sin(ang);
  i+=1;
);

);
function copy_params() ( P_wet=T_wet; P_dry=T_dry; P_exc=T_exc; P_decay=T_decay; P_damp=T_damp; );

// ---- panic machine: fade wet out, clear every buffer, fade back in. Triggered by button or by internal watchdog ----
function panic_step() (
  (panic_req>0.5 && pan_ph==0) ? ( pan_ph=1; );
  panic_req=0;
  pan_ph==1 ? ( pan_g-=pan_dn; pan_g<=0 ? ( pan_g=0; do_clear(); pan_ph=2; pan_hold=floor(0.03*srate); ); );
  pan_ph==2 ? ( pan_hold-=1; pan_hold<=0 ? ( pan_ph=3; ); );
  pan_ph==3 ? ( pan_g+=pan_up; pan_g>=1 ? ( pan_g=1; pan_ph=0; ); );
  pan_gs=pan_g*pan_g*(3-2*pan_g);
);

// ---- final stage: wet DC block, dry/wet sum, finite scrub, soft ceiling at +6 dB ----
function finish() local(yy) (
  wL=fin(wL); wR=fin(wR);
  yy=wL-wxL+dcr*wyL; wxL=wL; wyL=yy; wL=yy;
  yy=wR-wxR+dcr*wyR; wxR=wR; wyR=yy; wR=yy;
  oL=sclip(fin(inL*P_dry+wL*P_wet*pan_gs),CEIL);
  oR=sclip(fin(inR*P_dry+wR*P_wet*pan_gs),CEIL);
  spl0=oL; spl1=oR;
);

smc=1-exp(-1/(0.015*srate));
kmod=1-exp(-1/(0.004*srate));
dcr=1-TWOPI*10/srate;
pan_dn=1/(0.01*srate); pan_up=1/(0.05*srate); pan_g=1; pan_gs=1; pan_ph=0; panic_req=0;
ons_kfa=1-exp(-1/(0.001*srate)); ons_kfr=1-exp(-1/(0.025*srate));
ons_ksa=1-exp(-1/(0.040*srate)); ons_ksr=1-exp(-1/(0.250*srate));
ons_ratio=2.2; ons_thr=db2lin(-52); ons_refr=floor(0.07*srate);
bus_sel=1; imode=0; pfirst=1;
rng=7006;

@block

bus_update();
pan_btn=slider18; (pan_btn>0.5 && pan_prev<0.5) ? ( panic_req=1; ); pan_prev=pan_btn;
read_params();
pfirst ? ( copy_params(); pfirst=0; );


@sample

inL=fin(spl0); inR=fin(spl1);
pick_in();
ons_proc(xm);
panic_step();
mod_s+=(mod_t-mod_s)*kmod;
P_wet+=(T_wet-P_wet)*smc;
P_dry+=(T_dry-P_dry)*smc;
P_exc+=(T_exc-P_exc)*smc;
P_decay+=(T_decay-P_decay)*smc;
P_damp+=(T_damp-P_damp)*smc;

dn=-dn;
lr+=(log(root_t)-lr)*k_g;
lr=lim(lr,2.9,7.7);
exc=xm*P_exc;
sumL=0; sumR=0; i=0;
decay_eff=lim(P_decay*exp(md_dec*mod_s*2.0794415416798357),0.05,30);
while(i<NC) (
  cen[i]+=(lim(nact-i,0,1)-cen[i])*smc;
  dsm[i]+=((LSR-lr-lrt[i])-dsm[i])*k_d;
  dsm[i]=lim(dsm[i],0,12);
  Dm=lim(exp(dsm[i]),srate/FMAX,DLM-6);
  g=min(exp(-6.907755278982137*Dm/(srate*decay_eff)),0.997);
  base=cbuf+i*DLM;
  rp=wp-Dm; rp<0 ? (rp+=DLM);
  i0=floor(rp); fr=rp-i0; i1=i0+1; i1>=DLM ? (i1=0); i0>=DLM ? (i0=DLM-1);
  rv=base[i0]*(1-fr)+base[i1]*fr;
  clp[i]+=P_damp*(rv-clp[i]);
  base[wp]=sclip(exc*cen[i]+g*clp[i]+dn,3);
  o=rv*cen[i]*pow(1-g,0.75)*1.5;
  sumL+=o*pl_[i]; sumR+=o*pr_[i];
  abs(clp[i])<50 ? 0 : ( panic_req=1; );
  i+=1;
);
wp+=1; wp>=DLM ? (wp=0);
rpk=max(abs(sumL),abs(sumR)); rlv+=(rpk-rlv)*(rpk>rlv ? 0.02 : k_rl);
rg=rlv>0.5 ? 0.5/rlv : 1;
wL=sclip(sumL*rg,0.9); wR=sclip(sumR*rg,0.9);
(abs(wL)<20 && abs(wR)<20) ? 0 : ( panic_req=1; wL=0; wR=0; );
finish();

