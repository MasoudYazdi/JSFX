desc:CG Rupture - wavefold / bit-crush / decimate / rectify / asym-clip destruction chain
tags:musique-concrete distortion bitcrush wavefolder live
slider1:12<0,40,0.1>Drive (dB)
slider2:0.3<0,1,0.001>Fold
slider3:0.2<0,1,0.001>Fold Offset
slider4:16<1,16,0.01>Bit Depth
slider5:0<0,1,0.001>Crush Amount
slider6:1<0.005,1,0.0005:log>Sample-Rate Ratio
slider7:0<0,1,0.001>Rate Reduction Amount
slider8:0<0,1,0.001>Rectify
slider9:0.3<0,1,0.001>Clip
slider10:0.3<0,1,0.001>Clip Asymmetry
slider11:12000<200,20000,1:log>Low-pass (Hz)
slider12:40<20,2000,1:log>High-pass (Hz)
slider13:-6<-24,12,0.1>Output (dB)
slider14:0<-60,6,0.1>Wet (dB)
slider15:-60<-60,6,0.1>Dry (dB)
slider16:0<0,3,1{Auto,L,R,L+R}>Input
slider17:1<1,4,1>Analysis Bus (1-4)
slider18:0<0,6,1{None,Level,Onset,Brightness,Noisiness,Flux,Pitch}>Mod Source
slider19:0<-24,24,0.1>Mod -> Drive (dB)
slider20:0<-1,1,0.01>Mod -> Fold
slider21:0<0,1,1{-,PANIC}>Panic / Clear

in_pin:Input L
in_pin:Input R
out_pin:Output L
out_pin:Output R
options:gmem=CGbus no_meter

@init

ext_noinit=1;
PI=3.141592653589793; TWOPI=6.283185307179586; CEIL=2;

// ---- NaN-safe primitives. Comparisons with NaN are false, so every function below maps NaN/inf to a finite value ----
function lim(x,lo,hi) ( x>=lo ? (x<=hi ? x : hi) : lo );
function fin(x) ( abs(x)<100000 ? x : 0 );
function db2lin(d) ( exp(lim(d,-120,60)*0.11512925464970229) );
function dbgain(d) ( d<=-59.9 ? 0 : db2lin(d) );
function lin2db(x) ( 8.685889638065035*log(abs(x)+0.000000001) );
function sat(x) ( abs(x)<3 ? x*(27+x*x)/(27+9*x*x) : (x>0 ? 1 : -1) );
function sclip(x,c) local(ax,k,y) ( ax=abs(x); k=c*0.7; y=ax<k ? ax : k+(c-k)*sat((ax-k)/(c-k)); x<0 ? -y : y );
function mixf(a,b,t) ( a+(b-a)*t );
function lpc(fc) ( 1-exp(-TWOPI*lim(fc,1,srate*0.45)/srate) );
function smooth01(t) ( t<=0 ? 0 : (t>=1 ? 1 : t*t*(3-2*t)) );
function rnd() ( rng=rng*1664525+1013904223; rng-=floor(rng/4294967296)*4294967296; rng/4294967296 );
function rnds() ( rnd()*2-1 );
function alloc(n) local(p) ( p=mp; mp+=n; memset(p,0,n); p );

// ---- mono input pick (guitar usually lives on one channel) + DC block ----
function pick_in() local(yy) (
  eL+=(inL*inL-eL)*0.0005; eR+=(inR*inR-eR)*0.0005;
  imode<0.5 ? ( xm = eR<0.0005*eL ? inL : (eL<0.0005*eR ? inR : (inL+inR)*0.5) )
  : ( imode<1.5 ? ( xm=inL ) : ( imode<2.5 ? ( xm=inR ) : ( xm=(inL+inR)*0.5 ) ) );
  yy=xm-dcx+dcr*dcy; dcx=xm; dcy=yy; xm=fin(yy);
);

// ---- onset detector (fast/slow envelope ratio with refractory time) ----
function ons_proc(x) local(a) (
  a=abs(x);
  ons_f+=(a-ons_f)*(a>ons_f ? ons_kfa : ons_kfr);
  ons_s+=(a-ons_s)*(a>ons_s ? ons_ksa : ons_ksr);
  ons_ev=0;
  ons_cool>0 ? ons_cool-=1;
  (ons_cool<=0 && ons_f>ons_thr && ons_f>ons_s*ons_ratio) ? ( ons_ev=1; ons_cool=ons_refr; ons_cnt+=1; );
);

// ---- analysis bus (written by CG_Analyzer, optional for every other module) ----
function bus_update() (
  bus_b=(lim(floor(bus_sel+0.5),1,4)-1)*16;
  hb=gmem[bus_b];
  abs(hb-hb_last)>0.5 ? ( hb_last=hb; bus_stale=0; ) : ( bus_stale+=samplesblock; );
  bus_alive=bus_stale<srate*0.4;
);
function bus_get(sel) ( (sel>0.5 && bus_alive) ? lim(gmem[bus_b+floor(sel+0.5)],0,1) : 0 );
function bus_onset() local(c,r) ( r=0; bus_alive ? ( c=gmem[bus_b+10]; abs(c-bus_cnt_last)>0.5 ? ( r=1; bus_cnt_last=c; ); ); r );
mp=0;

holdL=0; holdR=0; dphL=0; dphR=0.5; l1L=0; l2L=0; l1R=0; l2R=0; h1L=0; h1R=0;
md_drive=0; md_fold=0;
function do_clear() ( holdL=0; holdR=0; l1L=0; l2L=0; l1R=0; l2R=0; h1L=0; h1R=0; );
function fold(x) local(m) ( m=(x-1)-4*floor((x-1)*0.25); abs(m-2)-1 );
// one channel of the chain. returns processed sample; hold/lowpass/highpass states are passed through globals by the caller
function stage(y,bias,dph_in) local(g,yf,q,lv,yc,cg,cb) (
  g=1+8*P_fold;
  yf=fold(g*y+bias);
  y=mixf(y,yf,lim(P_fold*4,0,1));
  lv=pow(2,max(P_bits,1)-1);
  q=floor(y*lv+0.5)/lv;
  y=mixf(y,q,P_cr);
  y=mixf(y,abs(y)*1.4,P_rect);
  cg=1+6*P_clip; cb=P_asym*1.5*(bias>=0 ? 1 : -1);
  yc=sat(cg*y+cb)-sat(cb);
  mixf(y,yc,lim(P_clip*3,0,1))
);

function read_params() (

bus_sel=slider17; imode=slider16; msel=slider18;
md_drive=lim(slider19,-24,24); md_fold=lim(slider20,-1,1); mod_t=bus_get(msel);
T_wet=dbgain(slider14); T_dry=dbgain(slider15);
T_drive=lim(slider1,0,40); T_fold=lim(slider2,0,1); T_bias=lim(slider3,0,1)*1.5;
T_bits=lim(slider4,1,16); T_cr=lim(slider5,0,1); T_rr=lim(slider6,0.005,1); T_ra=lim(slider7,0,1);
T_rect=lim(slider8,0,1); T_clip=lim(slider9,0,1); T_asym=lim(slider10,0,1);
T_lp=lpc(lim(slider11,200,20000)); T_hp=lpc(lim(slider12,20,2000));
T_out=db2lin(lim(slider13,-24,12));

);
function copy_params() ( P_wet=T_wet; P_dry=T_dry; P_drive=T_drive; P_fold=T_fold; P_bias=T_bias; P_bits=T_bits; P_cr=T_cr; P_rr=T_rr; P_ra=T_ra; P_rect=T_rect; P_clip=T_clip; P_asym=T_asym; P_lp=T_lp; P_hp=T_hp; P_out=T_out; );

// ---- panic machine: fade wet out, clear every buffer, fade back in. Triggered by button or by internal watchdog ----
function panic_step() (
  (panic_req>0.5 && pan_ph==0) ? ( pan_ph=1; );
  panic_req=0;
  pan_ph==1 ? ( pan_g-=pan_dn; pan_g<=0 ? ( pan_g=0; do_clear(); pan_ph=2; pan_hold=floor(0.03*srate); ); );
  pan_ph==2 ? ( pan_hold-=1; pan_hold<=0 ? ( pan_ph=3; ); );
  pan_ph==3 ? ( pan_g+=pan_up; pan_g>=1 ? ( pan_g=1; pan_ph=0; ); );
  pan_gs=pan_g*pan_g*(3-2*pan_g);
);

// ---- final stage: wet DC block, dry/wet sum, finite scrub, soft ceiling at +6 dB ----
function finish() local(yy) (
  wL=fin(wL); wR=fin(wR);
  yy=wL-wxL+dcr*wyL; wxL=wL; wyL=yy; wL=yy;
  yy=wR-wxR+dcr*wyR; wxR=wR; wyR=yy; wR=yy;
  oL=sclip(fin(inL*P_dry+wL*P_wet*pan_gs),CEIL);
  oR=sclip(fin(inR*P_dry+wR*P_wet*pan_gs),CEIL);
  spl0=oL; spl1=oR;
);

smc=1-exp(-1/(0.015*srate));
kmod=1-exp(-1/(0.004*srate));
dcr=1-TWOPI*10/srate;
pan_dn=1/(0.01*srate); pan_up=1/(0.05*srate); pan_g=1; pan_gs=1; pan_ph=0; panic_req=0;
ons_kfa=1-exp(-1/(0.001*srate)); ons_kfr=1-exp(-1/(0.025*srate));
ons_ksa=1-exp(-1/(0.040*srate)); ons_ksr=1-exp(-1/(0.250*srate));
ons_ratio=2.2; ons_thr=db2lin(-52); ons_refr=floor(0.07*srate);
bus_sel=1; imode=0; pfirst=1;
rng=7007;

@block

bus_update();
pan_btn=slider21; (pan_btn>0.5 && pan_prev<0.5) ? ( panic_req=1; ); pan_prev=pan_btn;
read_params();
pfirst ? ( copy_params(); pfirst=0; );


@sample

inL=fin(spl0); inR=fin(spl1);
pick_in();
ons_proc(xm);
panic_step();
mod_s+=(mod_t-mod_s)*kmod;
P_wet+=(T_wet-P_wet)*smc;
P_dry+=(T_dry-P_dry)*smc;
P_drive+=(T_drive-P_drive)*smc;
P_fold+=(T_fold-P_fold)*smc;
P_bias+=(T_bias-P_bias)*smc;
P_bits+=(T_bits-P_bits)*smc;
P_cr+=(T_cr-P_cr)*smc;
P_rr+=(T_rr-P_rr)*smc;
P_ra+=(T_ra-P_ra)*smc;
P_rect+=(T_rect-P_rect)*smc;
P_clip+=(T_clip-P_clip)*smc;
P_asym+=(T_asym-P_asym)*smc;
P_lp+=(T_lp-P_lp)*smc;
P_hp+=(T_hp-P_hp)*smc;
P_out+=(T_out-P_out)*smc;

// modulated drive and fold (analysis -> destruction depth)
dg=db2lin(lim(P_drive+md_drive*mod_s,-24,60));
fsave=P_fold; P_fold=lim(fsave+md_fold*mod_s,0,1);
yl=lim(xm*dg,-200,200); yr=lim(xm*dg,-200,200);
yl=stage(yl,P_bias,0); yr=stage(yr,-P_bias,0);
P_fold=fsave;
// sample-rate reduction (hold), mixed by amount
dphL+=P_rr; dphL>=1 ? ( dphL-=floor(dphL); holdL=yl; ); (dphL>=0 && dphL<1) ? 0 : (dphL=0);
dphR+=P_rr; dphR>=1 ? ( dphR-=floor(dphR); holdR=yr; ); (dphR>=0 && dphR<1) ? 0 : (dphR=0);
yl=mixf(yl,holdL,P_ra); yr=mixf(yr,holdR,P_ra);
// tone: two-pole low-pass, one-pole high-pass
l1L+=P_lp*(yl-l1L); l2L+=P_lp*(l1L-l2L); yl=l2L;
l1R+=P_lp*(yr-l1R); l2R+=P_lp*(l1R-l2R); yr=l2R;
h1L+=P_hp*(yl-h1L); yl=yl-h1L;
h1R+=P_hp*(yr-h1R); yr=yr-h1R;
wL=yl*P_out; wR=yr*P_out;
(abs(l2L)<50 && abs(l2R)<50 && abs(wL)<50 && abs(wR)<50) ? 0 : ( panic_req=1; wL=0; wR=0; );
finish();

