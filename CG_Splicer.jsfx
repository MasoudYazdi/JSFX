desc:CG Splicer - live slice capture / loop / stutter / reverse (tape-splice concrete)
tags:musique-concrete sampler looper live
slider1:300<20,2000,1:log>Slice Length (ms)
slider2:0<0,1,1{Past (last N ms),Forward (record N ms after trigger)}>Capture Mode
slider3:0<0,1,1{Own onset,Analyzer bus}>Trigger Source
slider4:0.5<0,1,0.01>Auto Trigger Probability
slider5:0.4<0.05,10,0.01:log>Min Interval (s)
slider6:0<0,1,1{-,GRAB}>Manual Grab
slider7:1<0,2,1{Off,Trigger,Trigger + Pitch}>MIDI Notes
slider8:0<-24,24,0.1>Pitch (semitones)
slider9:0<0,12,0.1>Pitch Random (semitones)
slider10:0.2<0,1,0.01>Reverse Probability
slider11:0<0,1,0.001>Loop Start
slider12:1<0.02,1,0.001>Loop Fraction
slider13:0<0,1,1{Loop,One-shot}>Loop Mode
slider14:20<2,200,1>Edge Fade (ms)
slider15:0.6<0,1,0.01>Stereo Width
slider16:-3<-60,6,0.1>Wet (dB)
slider17:0<-60,6,0.1>Dry (dB)
slider18:0.5<0,1,0.01>Duck Dry While Playing
slider19:0<0,3,1{Auto,L,R,L+R}>Input
slider20:1<1,4,1>Analysis Bus (1-4)
slider21:0<0,6,1{None,Level,Onset,Brightness,Noisiness,Flux,Pitch}>Mod Source
slider22:0<-1,1,0.01>Mod -> Loop Fraction
slider23:0<-12,12,0.1>Mod -> Pitch (semitones)
slider24:0<0,1,1{-,PANIC}>Panic / Clear

in_pin:Input L
in_pin:Input R
out_pin:Output L
out_pin:Output R
options:gmem=CGbus no_meter

@init

ext_noinit=1;
PI=3.141592653589793; TWOPI=6.283185307179586; CEIL=2;

// ---- NaN-safe primitives. Comparisons with NaN are false, so every function below maps NaN/inf to a finite value ----
function lim(x,lo,hi) ( x>=lo ? (x<=hi ? x : hi) : lo );
function fin(x) ( abs(x)<100000 ? x : 0 );
function db2lin(d) ( exp(lim(d,-120,60)*0.11512925464970229) );
function dbgain(d) ( d<=-59.9 ? 0 : db2lin(d) );
function lin2db(x) ( 8.685889638065035*log(abs(x)+0.000000001) );
function sat(x) ( abs(x)<3 ? x*(27+x*x)/(27+9*x*x) : (x>0 ? 1 : -1) );
function sclip(x,c) local(ax,k,y) ( ax=abs(x); k=c*0.7; y=ax<k ? ax : k+(c-k)*sat((ax-k)/(c-k)); x<0 ? -y : y );
function mixf(a,b,t) ( a+(b-a)*t );
function lpc(fc) ( 1-exp(-TWOPI*lim(fc,1,srate*0.45)/srate) );
function smooth01(t) ( t<=0 ? 0 : (t>=1 ? 1 : t*t*(3-2*t)) );
function rnd() ( rng=rng*1664525+1013904223; rng-=floor(rng/4294967296)*4294967296; rng/4294967296 );
function rnds() ( rnd()*2-1 );
function alloc(n) local(p) ( p=mp; mp+=n; memset(p,0,n); p );

// ---- mono input pick (guitar usually lives on one channel) + DC block ----
function pick_in() local(yy) (
  eL+=(inL*inL-eL)*0.0005; eR+=(inR*inR-eR)*0.0005;
  imode<0.5 ? ( xm = eR<0.0005*eL ? inL : (eL<0.0005*eR ? inR : (inL+inR)*0.5) )
  : ( imode<1.5 ? ( xm=inL ) : ( imode<2.5 ? ( xm=inR ) : ( xm=(inL+inR)*0.5 ) ) );
  yy=xm-dcx+dcr*dcy; dcx=xm; dcy=yy; xm=fin(yy);
);

// ---- onset detector (fast/slow envelope ratio with refractory time) ----
function ons_proc(x) local(a) (
  a=abs(x);
  ons_f+=(a-ons_f)*(a>ons_f ? ons_kfa : ons_kfr);
  ons_s+=(a-ons_s)*(a>ons_s ? ons_ksa : ons_ksr);
  ons_ev=0;
  ons_cool>0 ? ons_cool-=1;
  (ons_cool<=0 && ons_f>ons_thr && ons_f>ons_s*ons_ratio) ? ( ons_ev=1; ons_cool=ons_refr; ons_cnt+=1; );
);

// ---- analysis bus (written by CG_Analyzer, optional for every other module) ----
function bus_update() (
  bus_b=(lim(floor(bus_sel+0.5),1,4)-1)*16;
  hb=gmem[bus_b];
  abs(hb-hb_last)>0.5 ? ( hb_last=hb; bus_stale=0; ) : ( bus_stale+=samplesblock; );
  bus_alive=bus_stale<srate*0.4;
);
function bus_get(sel) ( (sel>0.5 && bus_alive) ? lim(gmem[bus_b+floor(sel+0.5)],0,1) : 0 );
function bus_onset() local(c,r) ( r=0; bus_alive ? ( c=gmem[bus_b+10]; abs(c-bus_cnt_last)>0.5 ? ( r=1; bus_cnt_last=c; ); ); r );
mp=0;

RB=floor(min(srate*6,1500000));
SLMAX=floor(min(srate*2.05,400000));
ring=alloc(RB); sbuf0=alloc(SLMAX); sbuf1=alloc(SLMAX);
vs=alloc(32);   // 2 voices x 16 fields
// voice fields: 0 act,1 len,2 rs,3 rl,4 pos,5 rate,6 gain,7 tgt,8 pl,9 pr,10 oneshot
rwp=0; cb=1; pend=0; pend_start=0; pend_cnt=0; cool=0; grab_prev=0; duck_env=0;
tsrc=0; capmode=0; midimode=1; loopmode=0; slen=300; minint=0.4; midi_semi=0; tr_prev=0;
k_duck=1-exp(-1/(0.05*srate));

function do_clear() local(v) (
  memset(ring,0,RB); memset(sbuf0,0,SLMAX); memset(sbuf1,0,SLMAX);
  v=0; while(v<2) ( vs[v*16]=0; vs[v*16+6]=0; vs[v*16+7]=0; v+=1; );
  pend=0; duck_env=0;
);

// copy [start,start+n) of the ring (wrapping) into dst
function ring_copy(dst,start,n) local(s,n1) (
  s=start; s<0 ? (s+=RB); s>=RB ? (s-=RB);
  (s+n<=RB) ? ( memcpy(dst,ring+s,n); ) : ( n1=RB-s; memcpy(dst,ring+s,n1); memcpy(dst+n1,ring,n-n1); );
);

// start playback of a freshly captured slice
function start_voice(len,semi) local(vv,o,ov,pr_,rate,rl,rs,ang,pan) (
  vv=cb; o=vs+vv*16; ov=vs+(1-vv)*16;
  pr_=P_pitch+semi+rnds()*P_pitchr+md_pitch*mod_s;
  rate=exp(lim(pr_,-36,36)*0.05776226504666211);
  rnd()<P_revp ? ( rate=-rate; );
  rl=lim(P_lfrac+md_loopfrac*mod_s*0.5,0.02,1)*len; rl=max(rl,64); rl>len ? ( rl=len; );
  rs=P_lstart*(len-rl);
  pan=rnds()*P_width; ang=(pan*0.5+0.5)*1.5707963267948966;
  o[0]=1; o[1]=len; o[2]=rs; o[3]=rl; o[5]=rate;
  o[4]=rate<0 ? rl-1 : 0;
  o[6]=0; o[7]=1; o[8]=cos(ang); o[9]=sin(ang); o[10]=loopmode;
  ov[7]=0;   // old voice fades out
);

function do_capture(start,len,semi) local(dst,nb) (
  nb=1-cb;
  vs[nb*16+6]>0.0005 ? ( 0; ) : (
    cb=nb;
    dst=cb==0 ? sbuf0 : sbuf1;
    ring_copy(dst,start,len);
    start_voice(len,semi);
  );
);

function trigger(semi) local(len,pre) (
  len=lim(floor(slen*0.001*srate),64,SLMAX-8);
  cool=floor(max(minint,2.2*P_fade*0.001)*srate);
  capmode<0.5 ? (
    do_capture(rwp-len,len,semi);
  ) : (
    pre=floor(0.004*srate);
    pend=1; pend_start=rwp-pre; pend_cnt=len+pre; pend_len=len; pend_semi=semi;
  );
);

function read_params() (

  bus_sel=slider20; imode=slider19; msel=slider21;
  T_wet=dbgain(slider16); T_dry=dbgain(slider17);
  T_width=lim(slider15,0,1); T_duck=lim(slider18,0,1);
  mod_t=bus_get(msel);
  T_pitch=lim(slider8,-24,24); T_pitchr=lim(slider9,0,12);
  T_revp=lim(slider10,0,1); T_lstart=lim(slider11,0,1);
  T_lfrac=lim(slider12,0.02,1); T_fade=lim(slider14,2,200);
  T_prob=lim(slider4,0,1);
  tsrc=slider3; capmode=slider2; midimode=slider7; loopmode=slider13;
  slen=lim(slider1,20,2000); minint=lim(slider5,0.05,10);
  md_loopfrac=lim(slider22,-1,1); md_pitch=lim(slider23,-12,12);


);
function copy_params() ( P_wet=T_wet; P_dry=T_dry; P_width=T_width; P_duck=T_duck; P_pitch=T_pitch; P_pitchr=T_pitchr; P_revp=T_revp; P_lstart=T_lstart; P_lfrac=T_lfrac; P_fade=T_fade; P_prob=T_prob; );

// ---- panic machine: fade wet out, clear every buffer, fade back in. Triggered by button or by internal watchdog ----
function panic_step() (
  (panic_req>0.5 && pan_ph==0) ? ( pan_ph=1; );
  panic_req=0;
  pan_ph==1 ? ( pan_g-=pan_dn; pan_g<=0 ? ( pan_g=0; do_clear(); pan_ph=2; pan_hold=floor(0.03*srate); ); );
  pan_ph==2 ? ( pan_hold-=1; pan_hold<=0 ? ( pan_ph=3; ); );
  pan_ph==3 ? ( pan_g+=pan_up; pan_g>=1 ? ( pan_g=1; pan_ph=0; ); );
  pan_gs=pan_g*pan_g*(3-2*pan_g);
);

// ---- final stage: wet DC block, dry/wet sum, finite scrub, soft ceiling at +6 dB ----
function finish() local(yy) (
  wL=fin(wL); wR=fin(wR);
  yy=wL-wxL+dcr*wyL; wxL=wL; wyL=yy; wL=yy;
  yy=wR-wxR+dcr*wyR; wxR=wR; wyR=yy; wR=yy;
  oL=sclip(fin(inL*P_dry+wL*P_wet*pan_gs),CEIL);
  oR=sclip(fin(inR*P_dry+wR*P_wet*pan_gs),CEIL);
  spl0=oL; spl1=oR;
);

smc=1-exp(-1/(0.015*srate));
kmod=1-exp(-1/(0.004*srate));
dcr=1-TWOPI*10/srate;
pan_dn=1/(0.01*srate); pan_up=1/(0.05*srate); pan_g=1; pan_gs=1; pan_ph=0; panic_req=0;
ons_kfa=1-exp(-1/(0.001*srate)); ons_kfr=1-exp(-1/(0.025*srate));
ons_ksa=1-exp(-1/(0.040*srate)); ons_ksr=1-exp(-1/(0.250*srate));
ons_ratio=2.2; ons_thr=db2lin(-52); ons_refr=floor(0.07*srate);
bus_sel=1; imode=0; pfirst=1;
rng=7002;

@block

bus_update();
pan_btn=slider24; (pan_btn>0.5 && pan_prev<0.5) ? ( panic_req=1; ); pan_prev=pan_btn;
read_params();
pfirst ? ( copy_params(); pfirst=0; );

// manual grab (rising edge)
(slider6>0.5 && grab_prev<0.5 && pend<0.5 && cool<=0) ? ( trigger(0); );
grab_prev=slider6;
// MIDI: pass everything through, optionally use note-on to trigger
midi_n=0;
while( midirecv(mofs,mm1,mm2,mm3) && midi_n<256 ) (
  midi_n+=1;
  (midimode>0.5 && (mm1&240)==144 && mm3>0 && pend<0.5 && cool<=0) ? (
    midimode>1.5 ? ( trigger(mm2-60); ) : ( trigger(0); );
  );
  midisend(mofs,mm1,mm2,mm3);
);


@sample

inL=fin(spl0); inR=fin(spl1);
pick_in();
ons_proc(xm);
panic_step();
mod_s+=(mod_t-mod_s)*kmod;
P_wet+=(T_wet-P_wet)*smc;
P_dry+=(T_dry-P_dry)*smc;
P_width+=(T_width-P_width)*smc;
P_duck+=(T_duck-P_duck)*smc;
P_pitch+=(T_pitch-P_pitch)*smc;
P_pitchr+=(T_pitchr-P_pitchr)*smc;
P_revp+=(T_revp-P_revp)*smc;
P_lstart+=(T_lstart-P_lstart)*smc;
P_lfrac+=(T_lfrac-P_lfrac)*smc;
P_fade+=(T_fade-P_fade)*smc;
P_prob+=(T_prob-P_prob)*smc;

// ---- record ring ----
ring[rwp]=xm; rwp+=1; rwp>=RB ? (rwp=0);
cool>0 ? ( cool-=1; );
// ---- pending forward capture ----
pend>0.5 ? ( pend_cnt-=1; pend_cnt<=0 ? ( pend=0; do_capture(pend_start,pend_len,pend_semi); ); );
// ---- auto trigger ----
trg = tsrc<0.5 ? ons_ev : bus_onset();
(trg && pend<0.5 && cool<=0 && rnd()<P_prob) ? ( trigger(0); );
// ---- voices ----
vstep=1/max(2,P_fade*0.001*srate);
mixL=0; mixR=0; act_sum=0; v=0;
while(v<2) (
  o=vs+v*16;
  o[0]>0.5 ? (
    o[7]>o[6] ? ( o[6]=min(o[6]+vstep,o[7]); ) : ( o[6]=max(o[6]-vstep,o[7]); );
    fn=max(1,floor(P_fade*0.001*srate));
    p=o[4];
    // edge window over the loop region
    wx=min(1,min(p/fn,(o[3]-p)/fn)); wx=smooth01(wx);
    idx=o[2]+p; i0=floor(idx); fr=idx-i0; i1=i0+1; i1>=o[1] ? (i1=o[1]-1); i0>=o[1] ? (i0=o[1]-1); i0<0 ? (i0=0);
    buf=v==0 ? sbuf0 : sbuf1;
    sv=buf[i0]*(1-fr)+buf[i1]*fr;
    gg=o[6]*o[6]*(3-2*o[6]); s=sv*wx*gg;
    mixL+=s*o[8]; mixR+=s*o[9];
    act_sum=max(act_sum,gg*wx);
    p+=o[5];
    (p>=o[3] || p<0) ? (
      o[10]>0.5 ? ( o[7]=0; p=lim(p,0,o[3]-1); o[5]=0; ) : ( p<0 ? (p+=o[3]) : (p-=o[3]); p=lim(p,0,o[3]-1); );
    );
    o[4]=p;
    (o[6]<=0.0005 && o[7]<0.5) ? ( o[0]=0; o[6]=0; );
  );
  v+=1;
);
duck_env+=(act_sum-duck_env)*k_duck;
P_dryduck=1-P_duck*duck_env;
wL=mixL; wR=mixR;
// apply ducking by scaling the dry inside finish via P_dry swap
sv_dry=P_dry; P_dry=sv_dry*P_dryduck;
finish();
P_dry=sv_dry;

