desc:CG Shimmer - pitch-shifting feedback cloud (each repeat is shifted again)
tags:musique-concrete shimmer pitch feedback live
slider1:420<100,1500,1:log>Time (ms)
slider2:12<-24,24,0.01>Pitch per Repeat (semitones)
slider3:6<0,30,0.1>Detune L/R (cents)
slider4:0.55<0,0.9,0.001>Feedback
slider5:0.7<0,1,0.01>Shifted Mix (0 = plain echo)
slider6:60<20,100,1>Window (ms)
slider7:6000<500,16000,1:log>Feedback Low-pass (Hz)
slider8:150<20,2000,1:log>Feedback High-pass (Hz)
slider9:300<20,2000,1:log>Time Slew (ms)
slider10:-4<-60,6,0.1>Wet (dB)
slider11:0<-60,6,0.1>Dry (dB)
slider12:0<0,3,1{Auto,L,R,L+R}>Input
slider13:1<1,4,1>Analysis Bus (1-4)
slider14:0<0,6,1{None,Level,Onset,Brightness,Noisiness,Flux,Pitch}>Mod Source
slider15:0<-0.4,0.4,0.01>Mod -> Feedback
slider16:0<-12,12,0.1>Mod -> Pitch (semitones)
slider17:0<0,1,1{-,PANIC}>Panic / Clear

in_pin:Input L
in_pin:Input R
out_pin:Output L
out_pin:Output R
options:gmem=CGbus no_meter

@init

ext_noinit=1;
PI=3.141592653589793; TWOPI=6.283185307179586; CEIL=2;

// ---- NaN-safe primitives. Comparisons with NaN are false, so every function below maps NaN/inf to a finite value ----
function lim(x,lo,hi) ( x>=lo ? (x<=hi ? x : hi) : lo );
function fin(x) ( abs(x)<100000 ? x : 0 );
function db2lin(d) ( exp(lim(d,-120,60)*0.11512925464970229) );
function dbgain(d) ( d<=-59.9 ? 0 : db2lin(d) );
function lin2db(x) ( 8.685889638065035*log(abs(x)+0.000000001) );
function sat(x) ( abs(x)<3 ? x*(27+x*x)/(27+9*x*x) : (x>0 ? 1 : -1) );
function sclip(x,c) local(ax,k,y) ( ax=abs(x); k=c*0.7; y=ax<k ? ax : k+(c-k)*sat((ax-k)/(c-k)); x<0 ? -y : y );
function mixf(a,b,t) ( a+(b-a)*t );
function lpc(fc) ( 1-exp(-TWOPI*lim(fc,1,srate*0.45)/srate) );
function smooth01(t) ( t<=0 ? 0 : (t>=1 ? 1 : t*t*(3-2*t)) );
function rnd() ( rng=rng*1664525+1013904223; rng-=floor(rng/4294967296)*4294967296; rng/4294967296 );
function rnds() ( rnd()*2-1 );
function alloc(sz) local(p) ( p=mp; mp+=sz; memset(p,0,sz); p );

// ---- mono input pick (guitar usually lives on one channel) + DC block ----
function pick_in() local(yy) (
  eL+=(inL*inL-eL)*0.0005; eR+=(inR*inR-eR)*0.0005;
  imode<0.5 ? ( xm = eR<0.0005*eL ? inL : (eL<0.0005*eR ? inR : (inL+inR)*0.5) )
  : ( imode<1.5 ? ( xm=inL ) : ( imode<2.5 ? ( xm=inR ) : ( xm=(inL+inR)*0.5 ) ) );
  yy=xm-dcx+dcr*dcy; dcx=xm; dcy=yy; xm=fin(yy);
);

// ---- onset detector (fast/slow envelope ratio with refractory time) ----
function ons_proc(x) local(a) (
  a=abs(x);
  ons_f+=(a-ons_f)*(a>ons_f ? ons_kfa : ons_kfr);
  ons_s+=(a-ons_s)*(a>ons_s ? ons_ksa : ons_ksr);
  ons_ev=0;
  ons_cool>0 ? ons_cool-=1;
  (ons_cool<=0 && ons_f>ons_thr && ons_f>ons_s*ons_ratio) ? ( ons_ev=1; ons_cool=ons_refr; ons_cnt+=1; );
);

// ---- analysis bus (written by CG_Analyzer, optional for every other module) ----
function bus_update() (
  bus_b=(lim(floor(bus_sel+0.5),1,4)-1)*16;
  hb=gmem[bus_b];
  abs(hb-hb_last)>0.5 ? ( hb_last=hb; bus_stale=0; ) : ( bus_stale+=samplesblock; );
  bus_alive=bus_stale<srate*0.4;
);
function bus_get(sel) ( (sel>0.5 && bus_alive) ? lim(gmem[bus_b+floor(sel+0.5)],0,1) : 0 );
function bus_onset() local(c,r) ( r=0; bus_alive ? ( c=gmem[bus_b+10]; abs(c-bus_cnt_last)>0.5 ? ( r=1; bus_cnt_last=c; ); ); r );
mp=0;

RA=floor(srate*1.6)+16;
RBm=floor(srate*0.3)+64;
abuf=alloc(RA); rbb=alloc(RBm);
BASE=24;
wa=0; wb=0; phL=0; phR=0.37; dsm=log(0.42*srate); lt=log(0.42*srate); k_sl=0.001; fbs=0; flp=0; fhp=0; Wn=0.06*srate; k_w=1-exp(-1/(0.2*srate));
md_fb=0; md_p=0; dn=0.000000000000001;

function do_clear() ( memset(abuf,0,RA); memset(rbb,0,RBm); fbs=0; flp=0; fhp=0; );
function rdb(lag) local(rp,i0,fr,i1) (
  rp=wb-lag; rp<0 ? (rp+=RBm); rp>=RBm ? (rp-=RBm);
  i0=floor(rp); fr=rp-i0; i1=i0+1; i1>=RBm ? (i1=0); i0>=RBm ? (i0=RBm-1); i0<0 ? (i0=0);
  rbb[i0]*(1-fr)+rbb[i1]*fr
);
function heads(ph,Wsm) local(p2,w1,sA,sB) (
  p2=ph+0.5; p2>=1 ? (p2-=1);
  w1=sin(3.141592653589793*ph); w1=w1*w1;
  sA=rdb(BASE+ph*Wsm); sB=rdb(BASE+p2*Wsm);
  sA*w1+sB*(1-w1)
);

function read_params() (

bus_sel=slider13; imode=slider12; msel=slider14;
T_wet=dbgain(slider10); T_dry=dbgain(slider11);
md_fb=lim(slider15,-0.4,0.4); md_p=lim(slider16,-12,12); mod_t=bus_get(msel);
T_fb=lim(lim(slider4,0,0.9)+md_fb*mod_s,0,0.9);
T_semi=lim(slider2,-24,24); T_det=lim(slider3,0,30); T_shim=lim(slider5,0,1); T_win=lim(slider6,20,100);
T_lp=lpc(lim(slider7,500,16000)); T_hp=lpc(lim(slider8,20,2000));
lt=log(lim(slider1,100,1500)*0.001*srate);
k_sl=1-exp(-1/(lim(slider9,20,2000)*0.001*srate));

);
function copy_params() ( P_wet=T_wet; P_dry=T_dry; P_fb=T_fb; P_semi=T_semi; P_det=T_det; P_shim=T_shim; P_win=T_win; P_lp=T_lp; P_hp=T_hp; );

// ---- panic machine: fade wet out, clear every buffer, fade back in. Triggered by button or by internal watchdog ----
function panic_step() (
  (panic_req>0.5 && pan_ph==0) ? ( pan_ph=1; );
  panic_req=0;
  pan_ph==1 ? ( pan_g-=pan_dn; pan_g<=0 ? ( pan_g=0; do_clear(); pan_ph=2; pan_hold=floor(0.03*srate); ); );
  pan_ph==2 ? ( pan_hold-=1; pan_hold<=0 ? ( pan_ph=3; ); );
  pan_ph==3 ? ( pan_g+=pan_up; pan_g>=1 ? ( pan_g=1; pan_ph=0; ); );
  pan_gs=pan_g*pan_g*(3-2*pan_g);
);

// ---- final stage: wet DC block, dry/wet sum, finite scrub, soft ceiling at +6 dB ----
function finish() local(yy) (
  wL=fin(wL); wR=fin(wR);
  yy=wL-wxL+dcr*wyL; wxL=wL; wyL=yy; wL=yy;
  yy=wR-wxR+dcr*wyR; wxR=wR; wyR=yy; wR=yy;
  oL=sclip(fin(inL*P_dry+wL*P_wet*pan_gs),CEIL);
  oR=sclip(fin(inR*P_dry+wR*P_wet*pan_gs),CEIL);
  spl0=oL; spl1=oR;
);

smc=1-exp(-1/(0.015*srate));
kmod=1-exp(-1/(0.004*srate));
dcr=1-TWOPI*10/srate;
pan_dn=1/(0.01*srate); pan_up=1/(0.05*srate); pan_g=1; pan_gs=1; pan_ph=0; panic_req=0;
ons_kfa=1-exp(-1/(0.001*srate)); ons_kfr=1-exp(-1/(0.025*srate));
ons_ksa=1-exp(-1/(0.040*srate)); ons_ksr=1-exp(-1/(0.250*srate));
ons_ratio=2.2; ons_thr=db2lin(-52); ons_refr=floor(0.07*srate);
bus_sel=1; imode=0; pfirst=1;
rng=7016;

@block

bus_update();
pan_btn=slider17; (pan_btn>0.5 && pan_prev<0.5) ? ( panic_req=1; ); pan_prev=pan_btn;
read_params();
pfirst ? ( copy_params(); pfirst=0; );


@sample

inL=fin(spl0); inR=fin(spl1);
pick_in();
ons_proc(xm);
panic_step();
mod_s+=(mod_t-mod_s)*kmod;
P_wet+=(T_wet-P_wet)*smc;
P_dry+=(T_dry-P_dry)*smc;
P_fb+=(T_fb-P_fb)*smc;
P_semi+=(T_semi-P_semi)*smc;
P_det+=(T_det-P_det)*smc;
P_shim+=(T_shim-P_shim)*smc;
P_win+=(T_win-P_win)*smc;
P_lp+=(T_lp-P_lp)*smc;
P_hp+=(T_hp-P_hp)*smc;

dn=-dn;
Wn+=(P_win*0.001*srate-Wn)*k_w;
dsm+=(lt-dsm)*k_sl; dsm=lim(dsm,4,13);
Dt=lim(exp(dsm),64,RA-8);
rp=wa-Dt; rp<0 ? (rp+=RA);
i0=floor(rp); fr=rp-i0; i1=i0+1; i1>=RA ? (i1=0); i0>=RA ? (i0=RA-1);
dsig=abuf[i0]*(1-fr)+abuf[i1]*fr;
rbb[wb]=dsig;
rate=exp(lim(P_semi+md_p*mod_s,-36,36)*0.05776226504666211);
dm=exp(P_det*0.000288811325233);
rl=rate/dm; rr=rate*dm;
phL+=(1-rl)/max(Wn,64); phL-=floor(phL); (phL>=0 && phL<1) ? 0 : (phL=0);
phR+=(1-rr)/max(Wn,64); phR-=floor(phR); (phR>=0 && phR<1) ? 0 : (phR=0);
cl=rdb(BASE);
sL=mixf(cl,heads(phL,Wn),lim(abs(rl-1)/0.015,0,1));
sR=mixf(cl,heads(phR,Wn),lim(abs(rr-1)/0.015,0,1));
wb+=1; wb>=RBm ? (wb=0);
// feedback: shifted material, filtered, saturated, bounded
fsrc=(sL+sR)*0.5;
flp+=P_lp*(fsrc-flp); fhp+=P_hp*(flp-fhp);
ff=flp-fhp; ff=sat(ff*1.2)*0.83;
fbs=lim(fin(ff),-2,2);
abuf[wa]=sclip(xm+P_fb*fbs+dn,2);
wa+=1; wa>=RA ? (wa=0);
wL=mixf(dsig,sL,P_shim); wR=mixf(dsig,sR,P_shim);
(abs(wL)<20 && abs(wR)<20 && abs(flp)<50) ? 0 : ( panic_req=1; wL=0; wR=0; );
finish();

