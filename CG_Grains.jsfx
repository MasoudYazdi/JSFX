desc:CG Grains - live granulator on the incoming guitar (no resynthesis)
tags:musique-concrete granular live
slider1:300<5,3000,1:log>Position (ms behind now)
slider2:150<0,2000,1>Position Spray (ms)
slider3:80<5,500,1:log>Grain Size (ms)
slider4:0.3<0,1,0.01>Size Random
slider5:20<0.5,200,0.1:log>Density (grains/s)
slider6:0<-24,24,0.1>Pitch (semitones)
slider7:0<0,24,0.1>Pitch Spray (semitones)
slider8:0.15<0,1,0.01>Reverse Probability
slider9:0.7<0,1,0.01>Stereo Spread
slider10:0.3<0,1,0.01>Window Sharpness
slider11:0<0,1,1{Live,Freeze buffer}>Freeze
slider12:-3<-60,6,0.1>Wet (dB)
slider13:0<-60,6,0.1>Dry (dB)
slider14:0<0,3,1{Auto,L,R,L+R}>Input
slider15:1<1,4,1>Analysis Bus (1-4)
slider16:0<0,6,1{None,Level,Onset,Brightness,Noisiness,Flux,Pitch}>Mod Source
slider17:0<-1,1,0.01>Mod -> Density (3 octaves)
slider18:0<-1,1,0.01>Mod -> Position (+-1000 ms)
slider19:0<-12,12,0.1>Mod -> Pitch (semitones)
slider20:0<0,1,1{-,PANIC}>Panic / Clear

in_pin:Input L
in_pin:Input R
out_pin:Output L
out_pin:Output R
options:gmem=CGbus no_meter

@init

ext_noinit=1;
PI=3.141592653589793; TWOPI=6.283185307179586; CEIL=2;

// ---- NaN-safe primitives. Comparisons with NaN are false, so every function below maps NaN/inf to a finite value ----
function lim(x,lo,hi) ( x>=lo ? (x<=hi ? x : hi) : lo );
function fin(x) ( abs(x)<100000 ? x : 0 );
function db2lin(d) ( exp(lim(d,-120,60)*0.11512925464970229) );
function dbgain(d) ( d<=-59.9 ? 0 : db2lin(d) );
function lin2db(x) ( 8.685889638065035*log(abs(x)+0.000000001) );
function sat(x) ( abs(x)<3 ? x*(27+x*x)/(27+9*x*x) : (x>0 ? 1 : -1) );
function sclip(x,c) local(ax,k,y) ( ax=abs(x); k=c*0.7; y=ax<k ? ax : k+(c-k)*sat((ax-k)/(c-k)); x<0 ? -y : y );
function mixf(a,b,t) ( a+(b-a)*t );
function lpc(fc) ( 1-exp(-TWOPI*lim(fc,1,srate*0.45)/srate) );
function smooth01(t) ( t<=0 ? 0 : (t>=1 ? 1 : t*t*(3-2*t)) );
function rnd() ( rng=rng*1664525+1013904223; rng-=floor(rng/4294967296)*4294967296; rng/4294967296 );
function rnds() ( rnd()*2-1 );
function alloc(n) local(p) ( p=mp; mp+=n; memset(p,0,n); p );

// ---- mono input pick (guitar usually lives on one channel) + DC block ----
function pick_in() local(yy) (
  eL+=(inL*inL-eL)*0.0005; eR+=(inR*inR-eR)*0.0005;
  imode<0.5 ? ( xm = eR<0.0005*eL ? inL : (eL<0.0005*eR ? inR : (inL+inR)*0.5) )
  : ( imode<1.5 ? ( xm=inL ) : ( imode<2.5 ? ( xm=inR ) : ( xm=(inL+inR)*0.5 ) ) );
  yy=xm-dcx+dcr*dcy; dcx=xm; dcy=yy; xm=fin(yy);
);

// ---- onset detector (fast/slow envelope ratio with refractory time) ----
function ons_proc(x) local(a) (
  a=abs(x);
  ons_f+=(a-ons_f)*(a>ons_f ? ons_kfa : ons_kfr);
  ons_s+=(a-ons_s)*(a>ons_s ? ons_ksa : ons_ksr);
  ons_ev=0;
  ons_cool>0 ? ons_cool-=1;
  (ons_cool<=0 && ons_f>ons_thr && ons_f>ons_s*ons_ratio) ? ( ons_ev=1; ons_cool=ons_refr; ons_cnt+=1; );
);

// ---- analysis bus (written by CG_Analyzer, optional for every other module) ----
function bus_update() (
  bus_b=(lim(floor(bus_sel+0.5),1,4)-1)*16;
  hb=gmem[bus_b];
  abs(hb-hb_last)>0.5 ? ( hb_last=hb; bus_stale=0; ) : ( bus_stale+=samplesblock; );
  bus_alive=bus_stale<srate*0.4;
);
function bus_get(sel) ( (sel>0.5 && bus_alive) ? lim(gmem[bus_b+floor(sel+0.5)],0,1) : 0 );
function bus_onset() local(c,r) ( r=0; bus_alive ? ( c=gmem[bus_b+10]; abs(c-bus_cnt_last)>0.5 ? ( r=1; bus_cnt_last=c; ); ); r );
mp=0;

RB=floor(min(srate*4,1600000));
ring=alloc(RB);
NG=32; GS=12;
gv=alloc(NG*GS);
// grain fields: 0 act,1 rd,2 rate,3 ph,4 dph,5 pl,6 pr,7 a(edge frac),8 amp
rwp=0; frozen=0; frz_req=0; frz_phase=0; frz_g=1; timer=0; frz_step=1/(0.006*srate);
md_dens=0; md_pos=0; md_pitch=0;

function do_clear() ( memset(ring,0,RB); memset(gv,0,NG*GS); timer=0; );

function spawn() local(v,found,o,Dg,L,rs,semi,d1,lo,hi,ang,pan,wv,a,amp,dsec) (
  found=-1; v=0;
  while(v<NG && found<0) ( gv[v*GS]<0.5 ? (found=v); v+=1; );
  found>=0 ? (
    o=gv+found*GS;
    dsec=lim(P_size*0.001*(1+(rnd()*2-1)*P_sizer*0.9),0.003,0.5);
    Dg=floor(dsec*srate); Dg=max(Dg,32);
    semi=P_pitch+(rnd()*2-1)*P_pitchs+md_pitch*mod_s;
    rs=exp(lim(semi,-36,36)*0.05776226504666211);
    rnd()<P_revp ? ( rs=-rs; );
    L=P_pos+(rnd()*2-1)*P_spray+md_pos*1000*mod_s;
    L=L*0.001*srate;
    wv=frozen ? 0 : 1;
    d1=(wv-rs)*Dg;                      // lag change over the grain's life
    lo=32+max(0,-d1); hi=RB-64-max(0,d1);
    L=lim(L,lo,hi);
    pan=(rnd()*2-1)*P_spread; ang=(pan*0.5+0.5)*1.5707963267948966;
    a=mixf(0.5,0.02,P_sharp);
    amp=1/sqrt(max(1,P_dens*dsec*0.6));
    o[0]=1; o[1]=rwp-L; o[2]=rs; o[3]=0; o[4]=1/Dg; o[5]=cos(ang); o[6]=sin(ang); o[7]=a; o[8]=amp;
  );
);

function read_params() (

bus_sel=slider15; imode=slider14; msel=slider16;
T_wet=dbgain(slider12); T_dry=dbgain(slider13);
T_pos=lim(slider1,5,3000); T_spray=lim(slider2,0,2000);
T_size=lim(slider3,5,500); T_sizer=lim(slider4,0,1);
md_dens=lim(slider17,-1,1); md_pos=lim(slider18,-1,1); md_pitch=lim(slider19,-12,12);
mod_t=bus_get(msel);
T_dens=lim(slider5,0.5,200)*exp(md_dens*mod_s*2.0794415416798357);
T_dens=lim(T_dens,0.25,300);
T_pitch=lim(slider6,-24,24); T_pitchs=lim(slider7,0,24);
T_revp=lim(slider8,0,1); T_spread=lim(slider9,0,1); T_sharp=lim(slider10,0,1);
frz_req=slider11>0.5;

);
function copy_params() ( P_wet=T_wet; P_dry=T_dry; P_pos=T_pos; P_spray=T_spray; P_size=T_size; P_sizer=T_sizer; P_dens=T_dens; P_pitch=T_pitch; P_pitchs=T_pitchs; P_revp=T_revp; P_spread=T_spread; P_sharp=T_sharp; );

// ---- panic machine: fade wet out, clear every buffer, fade back in. Triggered by button or by internal watchdog ----
function panic_step() (
  (panic_req>0.5 && pan_ph==0) ? ( pan_ph=1; );
  panic_req=0;
  pan_ph==1 ? ( pan_g-=pan_dn; pan_g<=0 ? ( pan_g=0; do_clear(); pan_ph=2; pan_hold=floor(0.03*srate); ); );
  pan_ph==2 ? ( pan_hold-=1; pan_hold<=0 ? ( pan_ph=3; ); );
  pan_ph==3 ? ( pan_g+=pan_up; pan_g>=1 ? ( pan_g=1; pan_ph=0; ); );
  pan_gs=pan_g*pan_g*(3-2*pan_g);
);

// ---- final stage: wet DC block, dry/wet sum, finite scrub, soft ceiling at +6 dB ----
function finish() local(yy) (
  wL=fin(wL); wR=fin(wR);
  yy=wL-wxL+dcr*wyL; wxL=wL; wyL=yy; wL=yy;
  yy=wR-wxR+dcr*wyR; wxR=wR; wyR=yy; wR=yy;
  oL=sclip(fin(inL*P_dry+wL*P_wet*pan_gs),CEIL);
  oR=sclip(fin(inR*P_dry+wR*P_wet*pan_gs),CEIL);
  spl0=oL; spl1=oR;
);

smc=1-exp(-1/(0.015*srate));
kmod=1-exp(-1/(0.004*srate));
dcr=1-TWOPI*10/srate;
pan_dn=1/(0.01*srate); pan_up=1/(0.05*srate); pan_g=1; pan_gs=1; pan_ph=0; panic_req=0;
ons_kfa=1-exp(-1/(0.001*srate)); ons_kfr=1-exp(-1/(0.025*srate));
ons_ksa=1-exp(-1/(0.040*srate)); ons_ksr=1-exp(-1/(0.250*srate));
ons_ratio=2.2; ons_thr=db2lin(-52); ons_refr=floor(0.07*srate);
bus_sel=1; imode=0; pfirst=1;
rng=7003;

@block

bus_update();
pan_btn=slider20; (pan_btn>0.5 && pan_prev<0.5) ? ( panic_req=1; ); pan_prev=pan_btn;
read_params();
pfirst ? ( copy_params(); pfirst=0; );


@sample

inL=fin(spl0); inR=fin(spl1);
pick_in();
ons_proc(xm);
panic_step();
mod_s+=(mod_t-mod_s)*kmod;
P_wet+=(T_wet-P_wet)*smc;
P_dry+=(T_dry-P_dry)*smc;
P_pos+=(T_pos-P_pos)*smc;
P_spray+=(T_spray-P_spray)*smc;
P_size+=(T_size-P_size)*smc;
P_sizer+=(T_sizer-P_sizer)*smc;
P_dens+=(T_dens-P_dens)*smc;
P_pitch+=(T_pitch-P_pitch)*smc;
P_pitchs+=(T_pitchs-P_pitchs)*smc;
P_revp+=(T_revp-P_revp)*smc;
P_spread+=(T_spread-P_spread)*smc;
P_sharp+=(T_sharp-P_sharp)*smc;

// ---- freeze state machine: fade grains out, kill them, flip, fade in (no clicks, no stale read heads) ----
(frz_phase==0 && frz_req!=frozen) ? ( frz_phase=1; );
frz_phase==1 ? ( frz_g-=frz_step; frz_g<=0 ? ( frz_g=0; memset(gv,0,NG*GS); frozen=frz_req; frz_phase=2; ); );
frz_phase==2 ? ( frz_g+=frz_step; frz_g>=1 ? ( frz_g=1; frz_phase=0; ); );
// ---- record ----
frozen ? 0 : ( ring[rwp]=xm; rwp+=1; rwp>=RB ? (rwp=0); );
// ---- schedule ----
timer-=1;
timer<=0 ? (
  (frz_phase==0 || frz_phase==2) ? spawn();
  timer=srate/max(P_dens,0.25)*(0.5+rnd());
  timer=min(timer,srate*4);
);
// ---- grains ----
gL=0; gR=0; v=0;
while(v<NG) (
  o=gv+v*GS;
  o[0]>0.5 ? (
    rp=o[1]; rp<0 ? (rp+=RB); rp>=RB ? (rp-=RB); rp<0 ? (rp=0);
    i0=floor(rp); fr=rp-i0; i1=i0+1; i1>=RB ? (i1=0); i0>=RB ? (i0=RB-1);
    sv=ring[i0]*(1-fr)+ring[i1]*fr;
    ph=o[3]; a=o[7];
    wx=ph<a ? ph/a : ((1-ph)<a ? (1-ph)/a : 1); wx=smooth01(wx);
    s=sv*wx*o[8];
    gL+=s*o[5]; gR+=s*o[6];
    o[1]=o[1]+o[2];
    o[1]<0 ? (o[1]+=RB); o[1]>=RB ? (o[1]-=RB);
    ph+=o[4]; o[3]=ph; ph>=1 ? (o[0]=0);
  );
  v+=1;
);
wL=gL*frz_g; wR=gR*frz_g;
// watchdog: grains are bounded by construction, but never let a bad value poison the output
(abs(wL)<20 && abs(wR)<20) ? 0 : ( panic_req=1; wL=0; wR=0; );
finish();

