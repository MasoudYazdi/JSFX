desc:CM Ring Modulator / Freq Shift (Mutation)
// Concrete Music Suite -- ring modulation against a sine carrier, with
// a secondary approximate frequency-shift mode. Models the classic
// "mutation" transformation that turns pitched or noisy material into
// inharmonic, bell-like, or metallic textures.
//
// Note: the Freq Shift mode is a single-oscillator approximation
// (amplitude modulation with a fixed-phase carrier), not a true
// single-sideband shift -- a real SSB shifter needs a wideband Hilbert
// transform on the input. This gives a related but audibly different
// "smeared" shifting character, which is often musically useful in its
// own right for concrete transformation work.

slider1:freq=440<1,5000,0.01>Carrier Frequency (Hz)
slider2:mode=0<0,1,1{Ring Mod,Approx Freq Shift}>Mode
slider3:shiftamt=0<-500,500,0.1>Shift Amount (Hz, Freq-Shift mode)
slider4:mix=1<0,1,0.01>Wet/Dry Mix
slider5:drive=1<0.1,4,0.01>Drive

in_pin:Left
in_pin:Right
out_pin:Left
out_pin:Right

@init
phase = 0;
shiftphase = 0;

@sample
phase += 2*$pi*freq/srate;
phase >= 2*$pi ? phase -= 2*$pi;
carrier = sin(phase);

mode == 0 ? (
  wetL = spl0*carrier*drive;
  wetR = spl1*carrier*drive;
) : (
  shiftphase += 2*$pi*shiftamt/srate;
  shiftphase >= 2*$pi ? shiftphase -= 2*$pi;
  shiftphase < -2*$pi ? shiftphase += 2*$pi;
  wetL = spl0*cos(shiftphase)*drive;
  wetR = spl1*cos(shiftphase)*drive;
);

spl0 = spl0*(1-mix) + wetL*mix;
spl1 = spl1*(1-mix) + wetR*mix;
