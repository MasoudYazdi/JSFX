desc:CG Modulator - 4-lane modulation source (deterministic / stochastic / chaotic) for all CG modules
tags:modulation chaos random lfo utility live
slider1:1<0,16,1{Off,Sine,Triangle,Saw Up,Saw Down,Square,Step Pattern,Onset Envelope,Sample+Hold,Smooth Noise,Random Walk,Poisson Bursts,Random Gate,Lorenz,Rossler,Logistic Map,Henon Map}>L1 Algorithm
slider2:0.5<0.01,40,0.001:log>L1 Rate (Hz)
slider3:0.5<0,1,0.001>L1 Shape / Chaos
slider4:20<0,2000,1>L1 Smooth (ms)
slider5:1<-1,1,0.001>L1 Depth
slider6:0.5<0,1,0.001>L1 Offset
slider7:9<0,16,1{Off,Sine,Triangle,Saw Up,Saw Down,Square,Step Pattern,Onset Envelope,Sample+Hold,Smooth Noise,Random Walk,Poisson Bursts,Random Gate,Lorenz,Rossler,Logistic Map,Henon Map}>L2 Algorithm
slider8:0.3<0.01,40,0.001:log>L2 Rate (Hz)
slider9:0.5<0,1,0.001>L2 Shape / Chaos
slider10:20<0,2000,1>L2 Smooth (ms)
slider11:1<-1,1,0.001>L2 Depth
slider12:0.5<0,1,0.001>L2 Offset
slider13:13<0,16,1{Off,Sine,Triangle,Saw Up,Saw Down,Square,Step Pattern,Onset Envelope,Sample+Hold,Smooth Noise,Random Walk,Poisson Bursts,Random Gate,Lorenz,Rossler,Logistic Map,Henon Map}>L3 Algorithm
slider14:0.8<0.01,40,0.001:log>L3 Rate (Hz)
slider15:0.5<0,1,0.001>L3 Shape / Chaos
slider16:20<0,2000,1>L3 Smooth (ms)
slider17:1<-1,1,0.001>L3 Depth
slider18:0.5<0,1,0.001>L3 Offset
slider19:11<0,16,1{Off,Sine,Triangle,Saw Up,Saw Down,Square,Step Pattern,Onset Envelope,Sample+Hold,Smooth Noise,Random Walk,Poisson Bursts,Random Gate,Lorenz,Rossler,Logistic Map,Henon Map}>L4 Algorithm
slider20:0.4<0.01,40,0.001:log>L4 Rate (Hz)
slider21:0.5<0,1,0.001>L4 Shape / Chaos
slider22:20<0,2000,1>L4 Smooth (ms)
slider23:1<-1,1,0.001>L4 Depth
slider24:0.5<0,1,0.001>L4 Offset
slider25:0<0,1,0.001>Lane Link (each lane's rate follows the previous lane)
slider26:0<0,6,1{None,Level,Onset,Brightness,Noisiness,Flux,Pitch}>Analysis -> All Rates
slider27:0<-1,1,0.01>Analysis -> Rate Depth (+-3 octaves)
slider28:1<1,4,1>Bus (1-4)
slider29:1<1,999,1>Seed
slider30:0<0,1,1{-,RESTART}>Restart (repeatable)

in_pin:Input L
in_pin:Input R
out_pin:Output L
out_pin:Output R
options:gmem=CGbus no_meter

@init

ext_noinit=1;
PI=3.141592653589793; TWOPI=6.283185307179586; CEIL=2;

// ---- NaN-safe primitives. Comparisons with NaN are false, so every function below maps NaN/inf to a finite value ----
function lim(x,lo,hi) ( x>=lo ? (x<=hi ? x : hi) : lo );
function fin(x) ( abs(x)<100000 ? x : 0 );
function db2lin(d) ( exp(lim(d,-120,60)*0.11512925464970229) );
function dbgain(d) ( d<=-59.9 ? 0 : db2lin(d) );
function lin2db(x) ( 8.685889638065035*log(abs(x)+0.000000001) );
function sat(x) ( abs(x)<3 ? x*(27+x*x)/(27+9*x*x) : (x>0 ? 1 : -1) );
function sclip(x,c) local(ax,k,y) ( ax=abs(x); k=c*0.7; y=ax<k ? ax : k+(c-k)*sat((ax-k)/(c-k)); x<0 ? -y : y );
function mixf(a,b,t) ( a+(b-a)*t );
function lpc(fc) ( 1-exp(-TWOPI*lim(fc,1,srate*0.45)/srate) );
function smooth01(t) ( t<=0 ? 0 : (t>=1 ? 1 : t*t*(3-2*t)) );
function rnd() ( rng=rng*1664525+1013904223; rng-=floor(rng/4294967296)*4294967296; rng/4294967296 );
function rnds() ( rnd()*2-1 );
function alloc(sz) local(p) ( p=mp; mp+=sz; memset(p,0,sz); p );

// ---- mono input pick (guitar usually lives on one channel) + DC block ----
function pick_in() local(yy) (
  eL+=(inL*inL-eL)*0.0005; eR+=(inR*inR-eR)*0.0005;
  imode<0.5 ? ( xm = eR<0.0005*eL ? inL : (eL<0.0005*eR ? inR : (inL+inR)*0.5) )
  : ( imode<1.5 ? ( xm=inL ) : ( imode<2.5 ? ( xm=inR ) : ( xm=(inL+inR)*0.5 ) ) );
  yy=xm-dcx+dcr*dcy; dcx=xm; dcy=yy; xm=fin(yy);
);

// ---- onset detector (fast/slow envelope ratio with refractory time) ----
function ons_proc(x) local(a) (
  a=abs(x);
  ons_f+=(a-ons_f)*(a>ons_f ? ons_kfa : ons_kfr);
  ons_s+=(a-ons_s)*(a>ons_s ? ons_ksa : ons_ksr);
  ons_ev=0;
  ons_cool>0 ? ons_cool-=1;
  (ons_cool<=0 && ons_f>ons_thr && ons_f>ons_s*ons_ratio) ? ( ons_ev=1; ons_cool=ons_refr; ons_cnt+=1; );
);

// ---- analysis bus (written by CG_Analyzer, optional for every other module) ----
function bus_update() (
  bus_b=(lim(floor(bus_sel+0.5),1,4)-1)*16;
  hb=gmem[bus_b];
  abs(hb-hb_last)>0.5 ? ( hb_last=hb; bus_stale=0; ) : ( bus_stale+=samplesblock; );
  bus_alive=bus_stale<srate*0.4;
  mb=gmem[bus_b+15];
  abs(mb-mb_last)>0.5 ? ( mb_last=mb; mbus_stale=0; ) : ( mbus_stale+=samplesblock; );
  mbus_alive=mbus_stale<srate*0.4;
);
// sel 1..6 = Analyzer streams, 7..10 = Modulator lanes 1..4 (bus slots 11..14). Everything is clamped 0..1.
function bus_get(sel) local(s) ( s=floor(sel+0.5); s<0.5 ? 0 : ( s<=6.5 ? (bus_alive ? lim(gmem[bus_b+s],0,1) : 0) : (mbus_alive ? lim(gmem[bus_b+s+4],0,1) : 0) ) );
function bus_onset() local(c,r) ( r=0; bus_alive ? ( c=gmem[bus_b+10]; abs(c-bus_cnt_last)>0.5 ? ( r=1; bus_cnt_last=c; ); ); r );
mp=0;

NLN=4; LSZ=16;
ls=alloc(NLN*LSZ); lpar=alloc(NLN*8); pat=alloc(NLN*8); lv=alloc(NLN); lo=alloc(NLN);
HN_=128; hist=alloc(NLN*HN_); hpos=0; hcnt=0;
// lane state fields: 0 phase,1 smoothed,2 target,3 prev target,4 x,5 y,6 z,7 step,8 env,9 walk,10 attack flag
dt_t=32/srate; ctl=0; seed=1; seed_prev=-1; link=0; amod_sel=0; amod_depth=0; amod_v=0;

function init_lanes() local(k,o,j) (
  k=0;
  while(k<NLN) (
    o=ls+k*LSZ; rng=seed*7919+k*104729+12345;
    j=0; while(j<LSZ) ( o[j]=0; j+=1; );
    o[2]=rnd(); o[3]=o[2]; o[4]=1+rnds()*0.1; o[5]=1+rnds()*0.1; o[6]=1+rnds()*0.1; o[9]=rnd();
    j=0; while(j<8) ( pat[k*8+j]=rnd(); j+=1; );
    lv[k]=0.5; lo[k]=0.5;
    k+=1;
  );
  rng=seed*31+7;
);
function do_clear() ( init_lanes(); );
function wrap01(x) ( x-floor(x) );

// advance lane k by one control tick, returns raw unit value 0..1
function lane_tick(k) local(o,alg,rate,shape,r,v,h,n,x,y,z,dx,dy,dz,i,rho,c,a,xn,tg) (
  o=ls+k*LSZ; alg=lpar[k*8]; rate=lpar[k*8+1]; shape=lpar[k*8+2];
  // rate with lane-link and analysis modulation (octaves), clamped
  r=rate*exp(lim(link*(lv[(k+3)&3]-0.5)*4+amod_v*amod_depth*3,-6,6)*0.6931471805599453);
  r=lim(r,0.005,60);
  v=lv[k];
  alg<0.5 ? ( v=0.5; );
  (alg>0.5 && alg<4.5) ? (
    o[0]=wrap01(o[0]+r*dt_t);
    alg<1.5 ? ( v=0.5+0.5*sin(TWOPI*o[0]); ) :
    ( alg<2.5 ? ( v=1-abs(2*o[0]-1); ) :
    ( alg<3.5 ? ( v=o[0]; ) : ( v=1-o[0]; ) ) );
  );
  (alg>4.5 && alg<5.5) ? ( o[0]=wrap01(o[0]+r*dt_t); v=o[0]<lim(shape,0.02,0.98) ? 1 : 0; );
  (alg>5.5 && alg<6.5) ? (
    o[0]+=r*dt_t; o[0]>=1 ? ( o[0]=wrap01(o[0]); o[7]=(o[7]+1)&7; );
    x=pat[k*8+o[7]]; v=x>shape ? x : 0;
  );
  (alg>6.5 && alg<7.5) ? (
    ons_lat ? ( o[8]=shape<0.01 ? 1 : o[8]; o[10]=shape<0.01 ? 0 : 1; );
    o[10]>0.5 ? ( o[8]+=dt_t/max(shape*0.5,0.005); o[8]>=1 ? ( o[8]=1; o[10]=0; ); ) : ( o[8]*=exp(-dt_t*r); );
    v=o[8];
  );
  (alg>7.5 && alg<8.5) ? ( o[0]+=r*dt_t; o[0]>=1 ? ( o[0]=wrap01(o[0]); o[2]=rnd(); ); v=o[2]; );
  (alg>8.5 && alg<9.5) ? (
    o[0]+=r*dt_t; o[0]>=1 ? ( o[0]=wrap01(o[0]); o[3]=o[2]; o[2]=rnd(); );
    v=o[3]+(o[2]-o[3])*(0.5-0.5*cos(3.141592653589793*o[0]));
  );
  (alg>9.5 && alg<10.5) ? (
    x=o[9]+rnds()*sqrt(r*dt_t)*(0.1+shape*1.5);
    x<0 ? ( x=-x; ); x>1 ? ( x=2-x; ); o[9]=lim(x,0,1); v=o[9];
  );
  (alg>10.5 && alg<11.5) ? (
    rnd()<r*dt_t ? ( o[8]=0.5+0.5*rnd(); );
    o[8]*=exp(-dt_t/(0.02+shape*1.5)); v=o[8];
  );
  (alg>11.5 && alg<12.5) ? ( o[0]+=r*dt_t; o[0]>=1 ? ( o[0]=wrap01(o[0]); o[2]=rnd()<shape ? 1 : 0; ); v=o[2]; );
  (alg>12.5 && alg<13.5) ? (   // Lorenz
    h=r*1.5*dt_t; n=lim(floor(h/0.01)+1,1,6); h=h/n; rho=mixf(24,38,shape);
    x=o[4]; y=o[5]; z=o[6]; i=0;
    while(i<n) ( dx=10*(y-x); dy=x*(rho-z)-y; dz=x*y-2.6666667*z; x+=h*dx; y+=h*dy; z+=h*dz; i+=1; );
    (abs(x)<100 && abs(y)<100 && abs(z)<150) ? ( o[4]=x; o[5]=y; o[6]=z; ) : ( o[4]=1; o[5]=1; o[6]=1; x=1; );
    v=lim(0.5+x/44,0,1);
  );
  (alg>13.5 && alg<14.5) ? (   // Rossler
    h=r*6*dt_t; n=lim(floor(h/0.02)+1,1,6); h=h/n; c=mixf(4,9,shape);
    x=o[4]; y=o[5]; z=o[6]; i=0;
    while(i<n) ( dx=-y-z; dy=x+0.2*y; dz=0.2+z*(x-c); x+=h*dx; y+=h*dy; z+=h*dz; i+=1; );
    (abs(x)<80 && abs(y)<80 && abs(z)<200) ? ( o[4]=x; o[5]=y; o[6]=z; ) : ( o[4]=1; o[5]=1; o[6]=0.5; x=1; );
    v=lim(0.5+x/24,0,1);
  );
  (alg>14.5 && alg<15.5) ? (   // logistic map stepped at rate
    o[0]+=r*dt_t; o[0]>=1 ? (
      o[0]=wrap01(o[0]); x=o[4]; (x>0.001 && x<0.999) ? 0 : ( x=0.37+0.2*rnd(); );
      x=mixf(3.5,3.999,shape)*x*(1-x); o[4]=lim(x,0.0005,0.9995);
    );
    v=lim(o[4],0,1);
  );
  (alg>15.5) ? (   // Henon map stepped at rate
    o[0]+=r*dt_t; o[0]>=1 ? (
      o[0]=wrap01(o[0]); x=o[4]; y=o[5];
      (abs(x)<3 && abs(y)<3) ? 0 : ( x=0.1; y=0.1; );
      a=mixf(1,1.4,shape); xn=1-a*x*x+y; o[5]=0.3*x; o[4]=xn;
      (abs(o[4])<3) ? 0 : ( o[4]=0.1; o[5]=0.1; );
    );
    v=lim(0.5+o[4]/3,0,1);
  );
  v=lim(v,0,1);
  lv[k]=v;
  v
);

function tick() local(k,u,sm,kk,outv) (
  amod_v=amod_sel>0.5 && bus_alive ? lim(gmem[bus_b+floor(amod_sel+0.5)],0,1) : 0;
  k=0;
  while(k<NLN) (
    u=lane_tick(k);
    sm=lpar[k*8+3];
    kk=sm<1 ? 1 : 1-exp(-dt_t/(sm*0.001));
    ls[k*LSZ+1]+=(u-ls[k*LSZ+1])*kk;
    outv=lim(lpar[k*8+5]+lpar[k*8+4]*(ls[k*LSZ+1]-0.5),0,1);
    lo[k]=outv;
    gmem[bus_b+11+k]=outv;
    k==0 ? (mo1=outv) : ( k==1 ? (mo2=outv) : ( k==2 ? (mo3=outv) : (mo4=outv) ) );
    k+=1;
  );
  ons_lat=0;
  (hcnt+=1)>=floor(srate/60/32)+1 ? ( hcnt=0; k=0; while(k<NLN) ( hist[k*HN_+hpos]=lo[k]; k+=1; ); hpos+=1; hpos>=HN_ ? (hpos=0); );
);
function lane_col(k) ( k==0 ? gfx_set(0.95,0.55,0.2,1) : ( k==1 ? gfx_set(0.3,0.8,0.95,1) : ( k==2 ? gfx_set(0.6,0.9,0.4,1) : gfx_set(0.9,0.4,0.8,1) ) ); );

function read_params() (
bus_sel=slider28; imode=0; mod_t=0;
lpar[0]=lim(slider1,0,16); lpar[1]=lim(slider2,0.01,40); lpar[2]=lim(slider3,0,1); lpar[3]=lim(slider4,0,2000); lpar[4]=lim(slider5,-1,1); lpar[5]=lim(slider6,0,1);
lpar[8]=lim(slider7,0,16); lpar[9]=lim(slider8,0.01,40); lpar[10]=lim(slider9,0,1); lpar[11]=lim(slider10,0,2000); lpar[12]=lim(slider11,-1,1); lpar[13]=lim(slider12,0,1);
lpar[16]=lim(slider13,0,16); lpar[17]=lim(slider14,0.01,40); lpar[18]=lim(slider15,0,1); lpar[19]=lim(slider16,0,2000); lpar[20]=lim(slider17,-1,1); lpar[21]=lim(slider18,0,1);
lpar[24]=lim(slider19,0,16); lpar[25]=lim(slider20,0.01,40); lpar[26]=lim(slider21,0,1); lpar[27]=lim(slider22,0,2000); lpar[28]=lim(slider23,-1,1); lpar[29]=lim(slider24,0,1);
link=lim(slider25,0,1); amod_sel=slider26; amod_depth=lim(slider27,-1,1);
seed=lim(floor(slider29+0.5),1,999); (seed!=seed_prev) ? ( seed_prev=seed; panic_req=1; );

);
function copy_params() ( 0; );

// ---- panic machine: fade wet out, clear every buffer, fade back in. Triggered by button or by internal watchdog ----
function panic_step() (
  (panic_req>0.5 && pan_ph==0) ? ( pan_ph=1; );
  panic_req=0;
  pan_ph==1 ? ( pan_g-=pan_dn; pan_g<=0 ? ( pan_g=0; do_clear(); pan_ph=2; pan_hold=floor(0.03*srate); ); );
  pan_ph==2 ? ( pan_hold-=1; pan_hold<=0 ? ( pan_ph=3; ); );
  pan_ph==3 ? ( pan_g+=pan_up; pan_g>=1 ? ( pan_g=1; pan_ph=0; ); );
  pan_gs=pan_g*pan_g*(3-2*pan_g);
);

// ---- final stage: wet DC block, dry/wet sum, finite scrub, soft ceiling at +6 dB ----
function finish() local(yy) (
  wL=fin(wL); wR=fin(wR);
  yy=wL-wxL+dcr*wyL; wxL=wL; wyL=yy; wL=yy;
  yy=wR-wxR+dcr*wyR; wxR=wR; wyR=yy; wR=yy;
  oL=sclip(fin(inL*P_dry+wL*P_wet*pan_gs),CEIL);
  oR=sclip(fin(inR*P_dry+wR*P_wet*pan_gs),CEIL);
  spl0=oL; spl1=oR;
);

smc=1-exp(-1/(0.015*srate));
kmod=1-exp(-1/(0.004*srate));
dcr=1-TWOPI*10/srate;
pan_dn=1/(0.01*srate); pan_up=1/(0.05*srate); pan_g=1; pan_gs=1; pan_ph=0; panic_req=0;
ons_kfa=1-exp(-1/(0.001*srate)); ons_kfr=1-exp(-1/(0.025*srate));
ons_ksa=1-exp(-1/(0.040*srate)); ons_ksr=1-exp(-1/(0.250*srate));
ons_ratio=2.2; ons_thr=db2lin(-52); ons_refr=floor(0.07*srate);
bus_sel=1; imode=0; pfirst=1;
rng=7021;

@block

bus_update();
pan_btn=slider30; (pan_btn>0.5 && pan_prev<0.5) ? ( panic_req=1; ); pan_prev=pan_btn;
read_params();
pfirst ? ( copy_params(); pfirst=0; );

gmem[bus_b+15]+=1; gmem[bus_b+15]>=1000000 ? ( gmem[bus_b+15]=1; );


@sample

inL=fin(spl0); inR=fin(spl1);
pick_in();
ons_proc(xm);
panic_step();
mod_s+=(mod_t-mod_s)*kmod;


ons_ev ? ( ons_lat=1; );
(ctl+=1)>=32 ? ( ctl=0; tick(); );
spl0=inL; spl1=inR;


@gfx 560 300

gfx_set(0.04,0.04,0.06,1); gfx_rect(0,0,gfx_w,gfx_h);
gfx_set(0.8,0.8,0.85,1); gfx_x=10; gfx_y=6; gfx_drawstr("CG MODULATOR  -> bus slots Mod 1..4");
k=0;
while(k<NLN) (
  y0=30+k*62; lane_col(k);
  gfx_x=10; gfx_y=y0; gfx_drawstr("L"); gfx_drawnumber(k+1,0); gfx_x=40; gfx_drawnumber(lo[k],3);
  i=1; while(i<HN_) (
    a=hist[k*HN_+((hpos+i-1)%HN_)]; b=hist[k*HN_+((hpos+i)%HN_)];
    gfx_line(100+(i-1)*3.4,y0+50-a*46,100+i*3.4,y0+50-b*46);
    i+=1;
  );
  k+=1;
);

